rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidAnswer(value) {
      return value is string
        && value in ['Malo', 'Regular', 'Bueno', 'Muy bueno', 'Excelente'];
    }

    function hasValidAnswers(answers) {
      return answers is map
        && answers.keys().hasOnly([
          'variedad', 'uso', 'presentacion', 'cantidades',
          'precio-mercado', 'precio-calidad', 'preventa', 'call-center',
          'entrega', 'cobro', 'disconformidades', 'devolucion'
        ])
        && answers.keys().hasAll([
          'variedad', 'uso', 'presentacion', 'cantidades',
          'precio-mercado', 'precio-calidad', 'preventa', 'call-center',
          'entrega', 'cobro', 'disconformidades', 'devolucion'
        ])
        && isValidAnswer(answers.variedad)
        && isValidAnswer(answers.uso)
        && isValidAnswer(answers.presentacion)
        && isValidAnswer(answers.cantidades)
        && isValidAnswer(answers['precio-mercado'])
        && isValidAnswer(answers['precio-calidad'])
        && isValidAnswer(answers.preventa)
        && isValidAnswer(answers['call-center'])
        && isValidAnswer(answers.entrega)
        && isValidAnswer(answers.cobro)
        && isValidAnswer(answers.disconformidades)
        && isValidAnswer(answers.devolucion);
    }

    function clienteDe(cedula) {
      return get(/databases/$(database)/documents/clientes/$(cedula)).data;
    }

    // El nombre y el vendedor no los escribe la persona: deben coincidir con la ficha
    // del cliente que ya está cargada desde el Excel de la empresa.
    function coincideConElCliente(data) {
      return data.cedula is string
        && data.cedula.matches('^[0-9A-Z]{5,30}$')
        && exists(/databases/$(database)/documents/clientes/$(data.cedula))
        && data.name == clienteDe(data.cedula).nombre
        && data.advisor == clienteDe(data.cedula).vendedor;
    }

    match /clientes/{cedula} {
      // Lectura de una ficha puntual: hay que saber la cédula exacta.
      // Listar la colección completa queda solo para cuentas autenticadas.
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if false;
    }

    match /encuestas_satisfaccion/{encuestaId} {
      // El ID del documento es el código único de la encuesta; como update está
      // prohibido, un código repetido no puede sobrescribir una respuesta existente.
      // Un mismo cliente sí puede enviar varias respuestas, cada una con su código.
      allow create: if request.resource.data.keys().hasOnly([
        'code', 'cedula', 'codigoCliente', 'name', 'advisor', 'respondent', 'answers', 'comment', 'submittedAt', 'source'
      ])
      && request.resource.data.respondent is string
      && request.resource.data.respondent.size() >= 3
      && request.resource.data.respondent.size() <= 80
      && encuestaId.matches('^EB-[A-HJ-NP-Z2-9]{8}$')
      && request.resource.data.code == encuestaId
      && request.resource.data.codigoCliente is string
      && request.resource.data.codigoCliente.size() <= 80
      && coincideConElCliente(request.resource.data)
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 2
      && request.resource.data.name.size() <= 150
      && hasValidAnswers(request.resource.data.answers)
      && request.resource.data.comment is string
      && request.resource.data.comment.size() <= 500
      && request.resource.data.submittedAt == request.time
      && request.resource.data.source == 'encuesta-satisfaccion-web';

      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    match /configuracion/{documento} {
      allow read: if documento == 'encuesta_actual';
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}